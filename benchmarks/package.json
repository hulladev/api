{
  "name": "@hulla/api-benchmarks",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze:size": "bun package-size.ts --analyze",
    "bench": "bun package-size.ts && bun fetch-roundtrip.ts && bun runners/adapters.ts",
    "bench:adapters": "bun runners/adapters.ts",
    "bench:implementations": "bun runners/server-implementations.ts",
    "bench:node": "bun package-size.ts && bun build fetch-roundtrip.ts --target=node --packages=external --outfile=node-runner.mjs && node node-runner.mjs",
    "check:size": "bun package-size.ts --check",
    "test": "vitest run harness/index.test.ts adapters/cohorts.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@hulla/api": "workspace:*",
    "@hulla/api-astro": "workspace:*",
    "@hulla/api-cloudflare": "workspace:*",
    "@hulla/api-express": "workspace:*",
    "@hulla/api-fastify": "workspace:*",
    "@hulla/api-google-cloud-functions": "workspace:*",
    "@hulla/api-h3": "workspace:*",
    "@hulla/api-hono": "workspace:*",
    "@hulla/api-message-port": "workspace:*",
    "@hulla/api-netlify-functions": "workspace:*",
    "@hulla/api-next": "workspace:*",
    "@hulla/api-node-http": "workspace:*",
    "@hulla/api-nuxt": "workspace:*",
    "@hulla/api-react-router": "workspace:*",
    "@hulla/api-solid-start": "workspace:*",
    "@hulla/api-sveltekit": "workspace:*",
    "@hulla/api-tanstack-start": "workspace:*",
    "@orpc/client": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/core-rc": "npm:@ts-rest/core@3.53.0-rc.1",
    "@ts-rest/express": "^3.52.1",
    "@ts-rest/serverless": "^3.52.1",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "fastify": "^5.12.1",
    "h3": "^2.0.1-rc.29",
    "hono": "^4.13.4",
    "next": "^16.3.2",
    "zod": "^4.4.3"
  }
}
