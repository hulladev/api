staged_files="$(git diff --cached --diff-filter=ACM --name-only)"

lint_files="$(printf '%s\n' "$staged_files" | grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$' || true)"
format_files="$(printf '%s\n' "$staged_files" | grep -E '\.(ts|tsx|js|jsx|mjs|cjs|json|md|yml|yaml)$' || true)"

if [ -n "$lint_files" ]; then
  printf '%s\n' "$lint_files" | xargs bunx oxlint --fix
fi

if [ -n "$format_files" ]; then
  printf '%s\n' "$format_files" | xargs bunx oxfmt --write
fi
