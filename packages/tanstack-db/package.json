{
  "name": "@hulla/api-tanstack-db",
  "version": "0.0.0",
  "description": "TanStack DB collection option builders for typed @hulla/api procedures",
  "keywords": [
    "@hulla",
    "@hulla/api",
    "@tanstack/db",
    "api",
    "crud",
    "database",
    "drizzle",
    "tanstack"
  ],
  "homepage": "https://hulla.dev/projects/api",
  "license": "MIT",
  "author": {
    "name": "Samuel Hulla",
    "email": "hulla@hulla.dev",
    "url": "https://hulla.dev"
  },
  "maintainers": [
    "Samuel Hulla <hulla@hulla.dev>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulladev/api.git",
    "directory": "packages/tanstack-db"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "build": "tsdown --config-loader unrun",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt --write .",
    "test": "tsc -p tsconfig.tests.json --noEmit && vitest run --config vitest.config.ts",
    "clean": "rm -rf node_modules dist"
  },
  "devDependencies": {
    "@hulla/api": "^1.2.5",
    "@tanstack/db": "^0.6.0",
    "@tanstack/query-core": "^5.90.0",
    "@tanstack/query-db-collection": "^1.0.0"
  },
  "peerDependencies": {
    "@hulla/api": "^1.2.5",
    "@tanstack/db": ">=0.6.0",
    "@tanstack/query-core": ">=5.0.0",
    "@tanstack/query-db-collection": ">=1.0.0"
  }
}
