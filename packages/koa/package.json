{
  "name": "@hulla/api-koa",
  "version": "2.0.0",
  "description": "Koa middleware adapter for @hulla/api",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hulla/api-node": "workspace:^"
  },
  "devDependencies": {
    "@hulla/api": "workspace:*",
    "@types/koa": "^3.0.0",
    "@types/node": "^26.2.0",
    "koa": "^3.0.0"
  },
  "peerDependencies": {
    "@hulla/api": "^2.0.0",
    "@types/koa": "^3.0.0",
    "@types/node": ">=22.0.0",
    "koa": "^3.0.0"
  }
}
