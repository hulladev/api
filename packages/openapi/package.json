{
  "name": "@hulla/api-openapi",
  "version": "0.0.0",
  "description": "OpenAPI generator for @hulla/api",
  "keywords": [
    "@hulla",
    "@hulla/api",
    "api",
    "openapi",
    "swagger",
    "zod"
  ],
  "homepage": "https://hulla.dev/projects/api",
  "license": "MIT",
  "author": {
    "name": "Samuel Hulla",
    "email": "hulla@hulla.dev",
    "url": "https://hulla.dev"
  },
  "maintainers": [
    "Samuel Hulla <hulla@hulla.dev>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulladev/api.git",
    "directory": "packages/openapi"
  },
  "bin": {
    "hulla-api-openapi": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt --write .",
    "build": "tsdown --config-loader unrun",
    "test": "tsc -p tsconfig.tests.json --noEmit && vitest run --config vitest.config.ts",
    "clean": "rm -rf node_modules dist"
  },
  "devDependencies": {
    "@hulla/api": "^1.2.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@hulla/api": "^1.2.5",
    "zod": "^3.25.0 || ^4.0.0"
  }
}
