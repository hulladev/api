{
  "name": "@hulla/api-elysia",
  "version": "2.0.1",
  "description": "Elysia server adapter for @hulla/api implementations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulladev/api.git",
    "directory": "packages/elysia"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hulla/api": "workspace:*",
    "elysia": "^1.4.29",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@hulla/api": "^2.0.1",
    "elysia": "^1.4.0"
  }
}
