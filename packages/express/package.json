{
  "name": "@hulla/api-express",
  "version": "0.0.0",
  "description": "Express transport adapter for @hulla/api handlers",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "test": "tsc -p tsconfig.tests.json --noEmit && vitest run --config vitest.config.ts",
    "lint": "oxlint .",
    "fmt": "oxfmt --check .",
    "clean": "rm -rf node_modules dist"
  },
  "devDependencies": {
    "@hulla/api": "^1.2.5"
  },
  "peerDependencies": {
    "@hulla/api": "^1.2.5"
  }
}
