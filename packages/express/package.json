{
  "name": "@hulla/api-express",
  "version": "2.0.2",
  "description": "Express server adapter for @hulla/api implementations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulladev/api.git",
    "directory": "packages/express"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hulla/api-node": "workspace:^"
  },
  "devDependencies": {
    "@hulla/api": "workspace:*",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@hulla/api": "^2.0.2",
    "@types/express": "^4.17.25 || ^5.0.0",
    "express": "^4.18.0 || ^5.0.0"
  }
}
