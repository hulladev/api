{
  "name": "@hulla/api-zod",
  "version": "2.0.0",
  "description": "Optional Zod integration for @hulla/api",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check:package": "publint",
    "clean": "rm -rf dist coverage",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hulla/api": "workspace:*",
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "valibot": "^1.4.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  }
}
