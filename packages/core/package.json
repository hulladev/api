{
  "name": "@hulla/api",
  "version": "0.0.0",
  "private": true,
  "description": "Directional Standard Schema contracts with typed client and server bindings",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    }
  },
  "scripts": {
    "bench": "bun bench/fetch-roundtrip.ts",
    "build": "tsdown",
    "check:package": "publint",
    "clean": "rm -rf dist coverage",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "valibot": "^1.4.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
