{
  "name": "@hulla/api-google-cloud-functions",
  "version": "2.0.2",
  "description": "Google Cloud Run functions HTTP adapter for @hulla/api",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulladev/api.git",
    "directory": "packages/google-cloud-functions"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist coverage",
    "test": "bun run build && vitest run",
    "test:coverage": "bun run build && vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@google-cloud/functions-framework": "^5.0.5",
    "@hulla/api": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@google-cloud/functions-framework": "^5.0.0",
    "@hulla/api": "^2.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
