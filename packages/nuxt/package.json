{
  "name": "@hulla/api-nuxt",
  "version": "2.0.0",
  "description": "Nuxt and Nitro integration for @hulla/api",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist coverage .nuxt .output",
    "test": "bun run build && vitest run",
    "test:coverage": "bun run build && vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "h3": "^2.0.1-rc.31",
    "ofetch": "^1.5.1"
  },
  "devDependencies": {
    "@hulla/api": "workspace:*",
    "nuxt": "^4.5.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@hulla/api": "^2.0.0",
    "nuxt": "^3.0.0 || ^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
