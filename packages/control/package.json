{
  "name": "@hulla/api-control",
  "version": "2.0.0",
  "description": "Result-returning @hulla/api clients powered by @hulla/control",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hulla/api": "workspace:^",
    "@hulla/control": "^0.0.3"
  },
  "devDependencies": {
    "zod": "^4.4.3"
  }
}
