{
  "name": "@hulla/api-react-router",
  "version": "2.0.0",
  "description": "React Router v7 resource route integration for @hulla/api",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist coverage",
    "test": "bun run build && vitest run",
    "test:coverage": "bun run build && vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hulla/api": "workspace:*",
    "@react-router/dev": "8.3.1",
    "@react-router/node": "8.3.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "isbot": "^5.1.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.1",
    "vite": "^8.2.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@hulla/api": "^2.0.0",
    "react-router": "^7.0.0"
  }
}
