{
  "name": "@hulla/api-solid-start",
  "version": "2.0.0",
  "description": "SolidStart API route integration for @hulla/api",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulladev/api.git",
    "directory": "packages/solid-start"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist coverage",
    "test": "bun run build && vitest run",
    "test:coverage": "bun run build && vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hulla/api": "workspace:*",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.3",
    "solid-js": "^1.9.15",
    "vite": "^8.2.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@hulla/api": "^2.0.0",
    "@solidjs/start": "^2.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
