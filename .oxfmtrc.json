{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 120,
  "ignorePatterns": ["dist/**", "node_modules/**", ".cache/**", ".turbo/**", ".playwright-cli/**", "*.md"],
  "sortImports": {
    "newlinesBetween": false
  },
  "sortPackageJson": null
}
