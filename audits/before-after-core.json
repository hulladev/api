  "methodology": "Three fresh Bun processes. Seven alternating-order batches of at least 30 ms, with 1,000 warmup calls. Dynamic Unicode path, validated params/JSON response, zero or five server middleware layers. Focused GET diagnostic, not socket throughput.",
  "fixtureSource": "import { z } from '/Users/samuel/Coding/hulla/api/benchmarks/node_modules/zod/index.js'\nconst current = '/Users/samuel/Coding/hulla/api/packages/core/dist'\nconst old = '/private/tmp/hulla-review-baseline/packages/core/dist'\nconst jobs = []\nfor (const [version, path] of [['before', old], ['after', current]]) {\n  const { defineContract, response, route } = await import(`${path}/index.js`)\n  const { defineServer } = await import(`${path}/server/index.js`)\n  const { defineClient } = await import(`${path}/client/index.js`)\n  const { inProcessTransport } = await import(`${path}/in-process/index.js`)\n  const { fetchAdapter, fetchTransport } = await import(`${path}/fetch/index.js`)\n  for (const depth of [0, 5]) {\n    const contract = defineContract({ routes: { get: route.get('/organizations/:org/users/:id', { params: z.object({ org: z.string(), id: z.string() }), responses: { 200: response.json(z.object({ id: z.string(), org: z.string() })) } }) } })\n    let server = defineServer(contract)\n    for (let i = 0; i < depth; i++) server = server.use(async ({next}) => next())\n    const implementation = server.implement({ get: ({params}) => ({status:200, body:params}) })\n    for (const transport of ['inprocess', 'fetch']) {\n      const scope = defineClient(contract, { transport: transport === 'fetch' ? fetchTransport({ baseUrl: 'http://bench', fetch: fetchAdapter().mount(implementation) }) : inProcessTransport(implementation) })\n      const client = version === 'before' ? scope.create() : scope\n      const run = async () => { const value = await client.get({params:{org:'example',id:'space /\u2713'}}); if(value.body.id !== 'space /\u2713') throw new Error('Invalid result') }\n      for(let i=0;i<1000;i++) await run()\n      jobs.push({version,depth,transport,run,samples:[]})\n    }\n  }\n}\nfor(let round=0;round<7;round++) {\n  const order=round%2? [...jobs].reverse():jobs\n  for(const job of order) {\n    let iterations=0; const start=performance.now()\n    do { for(let i=0;i<100;i++) await job.run(); iterations+=100 } while(performance.now()-start<30)\n    job.samples.push((performance.now()-start)*1e6/iterations)\n  }\n}\nconsole.log(JSON.stringify({processId:process.pid,results:jobs.map(({run,...value})=>value)}))\n",
