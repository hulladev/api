{
  "name": "@hulla/api-workspace",
  "version": "2.0.0",
  "private": true,
  "description": "Greenfield workspace for the directional @hulla/api contract runtime",
  "license": "MIT",
  "author": {
    "name": "Samuel Hulla",
    "email": "hulla@hulla.dev",
    "url": "https://hulla.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulladev/api.git"
  },
  "workspaces": [
    "packages/*",
    "benchmarks"
  ],
  "scripts": {
    "analyze:dead-code": "knip",
    "analyze:size": "bun run build && bun run --cwd benchmarks analyze:size",
    "bench": "bun run build && bun run --cwd benchmarks bench",
    "build": "turbo run build",
    "check": "bun run fmt && bun run lint && bun run lint:docs && bun run analyze:dead-code && bun run typecheck && bun run test && bun run build && bun run check:exports && bun run --cwd benchmarks check:size",
    "clean": "turbo run clean && rm -rf .turbo",
    "commit": "cz",
    "dev": "turbo run dev",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt --write .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "prepare": "husky",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "lint:docs": "bun scripts/check-docs.ts",
    "check:exports": "bun benchmarks/check-exports.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@hulla/api": "workspace:*",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "commitizen": "^4.3.2",
    "cz-emoji": "1.3.2-canary.2",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "typescript-api": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-emoji"
    },
    "cz-emoji": {
      "skipScope": true,
      "types": [
        {
          "emoji": "✅",
          "code": ":white_check_mark: feat:",
          "description": "a new functionality",
          "name": "feat"
        },
        {
          "emoji": "🐞",
          "code": ":lady_beetle: fix:",
          "description": "a bug fix",
          "name": "fix"
        },
        {
          "emoji": "🔧",
          "code": ":wrench: update:",
          "description": "a code change that neither fixes a bug nor adds a feature",
          "name": "update"
        },
        {
          "emoji": "📚",
          "code": ":books: docs:",
          "description": "documentations",
          "name": "docs"
        },
        {
          "emoji": "🧪",
          "code": ":test_tube: tests:",
          "description": "tests",
          "name": "tests"
        },
        {
          "emoji": "🪛",
          "code": ":screwdriver: config:",
          "description": "configuration files",
          "name": "config"
        },
        {
          "emoji": "🤖",
          "code": ":robot: devops:",
          "description": "ci/cd or other form of automation",
          "name": "devops"
        },
        {
          "emoji": "♻️",
          "code": ":recycle: cleanup:",
          "description": "code cleanup",
          "name": "cleanup"
        },
        {
          "emoji": "📦",
          "code": ":package: release:",
          "description": "new release bundle",
          "name": "release"
        }
      ]
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "bun@1.4.0"
}
