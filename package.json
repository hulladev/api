{
  "name": "@hulla/api-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Greenfield workspace for the directional @hulla/api contract runtime",
  "license": "MIT",
  "author": {
    "name": "Samuel Hulla",
    "email": "hulla@hulla.dev",
    "url": "https://hulla.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulladev/api.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bench": "turbo run bench",
    "build": "turbo run build",
    "check": "bun run fmt && bun run lint && bun run typecheck && bun run test && bun run build && bun run check:package",
    "check:package": "bun run --cwd packages/core check:package",
    "clean": "turbo run clean && rm -rf .turbo",
    "dev": "turbo run dev",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt --write .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "prepare": "husky",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@types/node": "^20.14.12",
    "husky": "^9.1.7",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "publint": "^0.3.18",
    "tsdown": "^0.22.14",
    "turbo": "^2.8.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "bun@1.3.14"
}
