{
  "name": "@hulla/api-drizzle",
  "version": "2.0.0-beta.1",
  "description": "Drizzle validation, CRUD router presets, and contract generation for @hulla/api",
  "keywords": [
    "@hulla",
    "@hulla/api",
    "api",
    "drizzle",
    "openapi"
  ],
  "homepage": "https://hulla.dev/projects/api",
  "license": "MIT",
  "author": {
    "name": "Samuel Hulla",
    "email": "hulla@hulla.dev",
    "url": "https://hulla.dev"
  },
  "maintainers": [
    "Samuel Hulla <hulla@hulla.dev>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulladev/api.git",
    "directory": "packages/drizzle"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.mts",
        "default": "./dist/config.mjs"
      },
      "require": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      }
    }
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt --write .",
    "build": "tsdown --config-loader unrun",
    "test": "tsc -p tsconfig.tests.json --noEmit && vitest run --config vitest.config.ts",
    "clean": "rm -rf node_modules dist"
  },
  "devDependencies": {
    "@hulla/api": "^2.0.0-beta.1",
    "drizzle-orm": "^1.0.0-beta.22",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@hulla/api": "^2.0.0-beta.1",
    "drizzle-orm": ">=0.36.0 || >=1.0.0-beta.0"
  }
}
