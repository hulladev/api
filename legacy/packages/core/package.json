{
  "name": "@hulla/api",
  "version": "2.0.0-beta.1",
  "description": "Typed internal procedures, explicit HTTP routes, and generated clients 🚀",
  "keywords": [
    "@hulla",
    "@hulla/api",
    "@tanstack/react-query",
    "api",
    "axios",
    "firebase",
    "graphql",
    "http",
    "hulla",
    "hulla api",
    "hulla dev",
    "hulla/api",
    "mutation",
    "query",
    "query manager",
    "react-query",
    "rest",
    "server actions",
    "supabase",
    "swr",
    "tanstack",
    "trpc"
  ],
  "homepage": "https://hulla.dev/projects/api",
  "license": "MIT",
  "author": {
    "name": "Samuel Hulla",
    "email": "hulla@hulla.dev",
    "url": "https://hulla.dev"
  },
  "maintainers": [
    "Samuel Hulla <hulla@hulla.dev>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulladev/api.git",
    "directory": "packages/core"
  },
  "bin": {
    "hulla-api": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.mts",
        "default": "./dist/runtime.mjs"
      },
      "require": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.mts",
        "default": "./dist/client.mjs"
      },
      "require": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.mts",
        "default": "./dist/plugin.mjs"
      },
      "require": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.mts",
        "default": "./dist/zod.mjs"
      },
      "require": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      }
    }
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "build": "tsdown --config-loader unrun",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt --write .",
    "test": "tsc -p tsconfig.tests.json --noEmit && vitest run --config vitest.config.ts",
    "clean": "rm -rf node_modules dist"
  },
  "dependencies": {
    "jiti": "^2.6.1",
    "picomatch": "^4.0.4"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
