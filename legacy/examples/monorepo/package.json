{
  "name": "hulla-api-monorepo-example",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "generate": "bun run link-local && bun run scripts/generate.ts",
    "format:generated": "oxfmt --write apps/web/src/routeTree.gen.ts packages/api-client/src/generated packages/api-client/src/index.ts",
    "link-local": "bun run scripts/link-local.ts",
    "dev": "bun run generate && turbo dev",
    "dev:backend": "bun run generate && turbo dev --filter=@fitness/backend",
    "dev:mobile": "bun run generate && turbo dev --filter=@fitness/mobile",
    "dev:web": "bun run generate && turbo dev --filter=@fitness/web",
    "build": "bun run generate && turbo build",
    "typecheck": "bun run generate && turbo typecheck",
    "smoke": "bun run generate && bun scripts/smoke.ts",
    "check": "bun run generate && turbo typecheck build && bun run format:generated && bun scripts/smoke.ts"
  },
  "dependencies": {
    "@fitness/api-client": "workspace:*",
    "@hulla/api": "file:../../packages/core",
    "@hulla/api-drizzle": "file:../../packages/drizzle",
    "@hulla/api-tanstack-db": "file:../../packages/tanstack-db",
    "@hulla/api-tanstack-query": "file:../../packages/tanstack-query",
    "@tanstack/db": "latest",
    "@tanstack/query-core": "latest",
    "@tanstack/query-db-collection": "latest",
    "@tanstack/react-db": "latest",
    "@tanstack/react-query": "latest",
    "drizzle-orm": "1.0.0-rc.4-5d5b77c",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "0.36.0",
    "turbo": "^2.8.14",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14"
}
