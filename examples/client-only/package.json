{
  "name": "hulla-api-client-only-example",
  "private": true,
  "type": "module",
  "scripts": {
    "link-local": "bun run scripts/link-local.ts",
    "typecheck": "bun run link-local && tsc --noEmit",
    "build": "bun run link-local && bun build src/client.ts --outdir dist --target browser",
    "smoke": "bun run link-local && bun src/smoke.ts",
    "check": "bun run typecheck && bun run build && bun run smoke"
  },
  "dependencies": {
    "@hulla/api": "file:../../packages/core",
    "@hulla/api-swr": "file:../../packages/swr",
    "@hulla/api-tanstack-query": "file:../../packages/tanstack-query",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14"
}
